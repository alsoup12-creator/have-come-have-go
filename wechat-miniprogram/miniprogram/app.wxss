page {
  min-height: 100%;
  background: #faf9f6;
  color: #172a27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 32rpx 160rpx;
}

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  box-sizing: border-box;
  overflow: hidden;
  width: calc(100% + 64rpx);
  min-height: 240rpx;
  margin: 0 -32rpx 28rpx;
  padding: 0 32rpx 28rpx;
  color: #ffffff;
  background-color: #3d6657;
  border-radius: 0;
}

.hero-bg {
  position: absolute;
  z-index: 0;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.eyebrow {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: 6rpx;
  color: #ffffff;
  font-size: 24rpx;
  letter-spacing: 0;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .7);
}

.hero-title {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .7);
}

.hero-copy {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 14rpx;
  max-width: 590rpx;
  color: rgba(255, 255, 255, .88);
  font-size: 25rpx;
  line-height: 1.65;
}

.card {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 28rpx 30rpx;
  background: rgba(255, 255, 255, .94);
  border: 1rpx solid rgba(49, 109, 90, .09);
  border-radius: 32rpx;
  box-shadow: none;
}

.card-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.muted {
  color: #7c817d;
  font-size: 24rpx;
  line-height: 1.6;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 82rpx;
  padding: 0 30rpx;
}

.primary-button {
  color: #ffffff;
  background: #316d5a;
}

.secondary-button {
  color: #316d5a;
  background: #e8f0eb;
}

.danger-button {
  color: #8b3939;
  background: #faece8;
}

.button-row {
  display: flex;
  gap: 18rpx;
}

.button-row button {
  flex: 1;
}

.field {
  margin-bottom: 26rpx;
}

.field-label {
  display: block;
  margin: 0 4rpx 12rpx;
  color: #4f5c57;
  font-size: 25rpx;
  font-weight: 600;
}

.input,
.picker-value,
.textarea {
  box-sizing: border-box;
  width: 100%;
  color: #25312d;
  background: #ffffff;
  border: 1rpx solid #dde4df;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.input {
  height: 92rpx;
  min-height: 92rpx;
  padding: 0 24rpx;
  line-height: 92rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 24rpx;
  line-height: 1.4;
}

.textarea {
  min-height: 200rpx;
  padding: 22rpx 24rpx;
  line-height: 1.65;
}

.placeholder {
  color: #a3aaa6;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  color: #316d5a;
  background: #eaf1ed;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.empty {
  padding: 88rpx 34rpx;
  text-align: center;
}

.empty-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #ebeeeb;
}
