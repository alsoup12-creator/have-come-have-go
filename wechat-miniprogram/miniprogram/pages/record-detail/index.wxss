.detail-page{padding-top:42rpx;padding-bottom:80rpx}.detail-head{margin-bottom:30rpx}.detail-title{display:block;font-size:42rpx;font-weight:700}.detail-amount{display:block;margin:10rpx 0;color:#316d5a;font-size:54rpx;font-weight:700}.image-scroll{width:calc(100% + 32rpx);margin-bottom:26rpx}.image-list{display:inline-flex;gap:16rpx;padding-right:32rpx}.image-list image{width:390rpx;height:320rpx;border-radius:26rpx}.detail-lines view{display:flex;justify-content:space-between;gap:24rpx;padding:16rpx 0;border-bottom:1rpx solid #ecefeb}.detail-lines view:last-child{border:0}.detail-lines text:first-child{color:#7c817d}.detail-lines text:last-child{max-width:65%;text-align:right;font-weight:600}.note{line-height:1.7}.evidence{background:#f7ede2}.edit-button{width:100%;margin-bottom:18rpx}.disclaimer{display:block;margin:22rpx 6rpx;color:#8d938f;font-size:22rpx;line-height:1.7}.delete-button{width:100%;margin-top:34rpx}
