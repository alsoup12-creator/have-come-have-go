.compact-hero {
  padding-bottom: 34rpx;
}

.relation-filter,
.record-top,
.summary-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.toolbox{margin-bottom:20rpx;padding:22rpx;background:#fff;border:1rpx solid #e5e8e4;border-radius:26rpx}.period,.sort,.sort>view{display:flex;align-items:center;gap:14rpx}.period picker{flex:1}.period picker view{padding:16rpx;background:#f5f5f1;border-radius:16rpx;text-align:center;font-size:24rpx}.sort{justify-content:space-between;margin-top:18rpx;color:#7a827d;font-size:23rpx}.sort>view text{padding:10rpx 16rpx;border-radius:999rpx}.sort>view text.active{color:#316d5a;background:#eaf1ed;font-weight:700}.record-meta{display:block;margin-top:8rpx;color:#7f8782;font-size:23rpx}.record-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx}.record-material,.record-pending{display:inline-flex;padding:7rpx 12rpx;border-radius:999rpx;font-size:20rpx}.record-material{color:#52665e;background:#edf2ee}.record-pending{color:#8a5f39;background:#f7ede2}

.relation-name {
  display: block;
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.filter-row {
  width: calc(100% + 56rpx);
  margin: 0 -28rpx 16rpx;
  white-space: nowrap;
}

.filter-inner {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 28rpx 8rpx;
}

.filter-chip {
  padding: 15rpx 24rpx;
  color: #6d7772;
  background: #ebece8;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.filter-chip.active {
  color: #ffffff;
  background: #316d5a;
}

.summary-line {
  margin: 20rpx 4rpx;
  color: #6d7772;
  font-size: 24rpx;
}

.record {
  position: relative;
}

.record-main {
  padding-right: 4rpx;
}

.record-title {
  font-weight: 700;
}

.record-amount {
  color: #316d5a;
  font-size: 31rpx;
  font-weight: 700;
}

.record-note {
  display: block;
  margin-top: 14rpx;
  color: #58645f;
  font-size: 24rpx;
  line-height: 1.6;
}
