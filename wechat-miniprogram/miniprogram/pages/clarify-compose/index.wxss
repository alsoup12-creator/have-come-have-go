.compose-page{padding-top:34rpx;padding-bottom:80rpx}.compose-head{margin-bottom:32rpx}.eyebrow-dark{display:block;color:#507365;font-size:23rpx}.compose-title{display:block;margin:8rpx 0;font-size:40rpx;font-weight:700}.scope-card{background:#edf4ef}.draft-textarea{box-sizing:border-box;width:100%;height:620rpx;padding:28rpx;color:#25312d;background:#fff;border:1rpx solid #dfe5e0;border-radius:24rpx;font-size:27rpx;line-height:1.8}.disclaimer{display:block;margin:22rpx 6rpx;color:#8c928e;font-size:22rpx;line-height:1.7}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin:10rpx 0 24rpx}.steps view{padding:16rpx 8rpx;color:#88908b;background:#efefeb;border-radius:18rpx;text-align:center;font-weight:700}.steps view.active{color:#fff;background:#316d5a}.steps text{display:block;margin-top:6rpx;font-size:20rpx;font-weight:400}.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-bottom:30rpx}.summary-grid view{padding:22rpx 8rpx;background:#f7ede2;border-radius:20rpx;text-align:center}.summary-grid text{display:block;color:#704c36;font-weight:700}.summary-grid text:last-child{margin-top:6rpx;font-size:21rpx;font-weight:400}.material-head,.material-label{display:flex;justify-content:space-between}.material-head{margin-bottom:16rpx;color:#316d5a;font-weight:700}.fact-lines{margin-top:20rpx;padding:20rpx;background:#f6f6f2;border-radius:18rpx}.fact-lines text{display:block;margin:6rpx 0;color:#59635f;font-size:23rpx;line-height:1.5}.material-label{margin:24rpx 0 14rpx}.material-label text:first-child{font-weight:700}.material-label text:last-child{color:#8a908c;font-size:21rpx}.image-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx}.image-item{position:relative}.image-item image{width:100%;height:230rpx;border-radius:18rpx}.image-item>text{display:block;margin-top:6rpx;color:#7d847f;font-size:21rpx}.image-item .remove-image{position:absolute;right:10rpx;top:10rpx;margin:0;padding:8rpx 12rpx;color:#fff;background: